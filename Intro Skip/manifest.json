{
  "$schema": "https://raw.githubusercontent.com/nike4613/ModSaber-MetadataFileSchema/master/Schema.json",
  "author": "Auros",
  "description": "Allows you to skip intros and outros of songs that are longer than 5 seconds without any significant objects.",
  "gameVersion": "1.45.3",
  "id": "IntroSkip",
  "name": "Intro Skip",
  "version": "4.1.0",
  "icon": "IntroSkip.UI.intro-skip.png",
  "dependsOn": {
    "BSIPA": "^5.0.0",
    "SiraUtil": "^3.0.0",
    "BeatSaberMarkupLanguage": "^1.1.0"
  },
  "links": {
    "project-source": "https://github.com/Auros/Intro-Skip",
    "donate": "https://ko-fi.com/kyle1413k"
  },
  "loadAfter": [
    "Counters+"
  ],
  "features": {
    "CountersPlus.CustomCounter": {
      "Name": "Intro Skip Prompt",
      "Description": "Places the \"Press Trigger To Skip\" prompt with your other counters.",
      "CounterLocation": "IntroSkip.Counters.SkipPromptCounter",
      "PreviewLocation": "IntroSkip.Counters.SkipPromptCounterPreview",
      "ConfigDefaults": {
        "Enabled": true,
        "Position": "AboveHighway",
        "Distance": 0
      }
    }
  }
}
